{
  "name": "@ngertiin/desktop",
  "productName": "Ngertiin Dev",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/dev.ts",
    "package": "bun scripts/package.ts",
    "test": "bun test tests",
    "test:e2e": "bun run build && node node_modules/@playwright/test/cli.js test --config playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts tests verification *.ts *.json *.cjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "@electron-forge/cli": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "@types/bun": "1.3.10",
    "vite": "8.3.5",
    "sharp": "0.35.5"
  },
  "type": "module"
}
