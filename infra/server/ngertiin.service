[Unit]
Description=Ngertiin central server
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ngertiin
Group=ngertiin
SupplementaryGroups=docker
WorkingDirectory=/opt/ngertiin/current
EnvironmentFile=/etc/ngertiin/server.env
Environment=PATH=/opt/ngertiin/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/opt/ngertiin/bin/bun apps/server/src/operations/cli.ts check /etc/ngertiin/operations.json
ExecStart=/opt/ngertiin/bin/bun apps/server/src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ngertiin
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
