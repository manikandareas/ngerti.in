# Harness-first development. No provider credentials are required for foundation startup.
APP_ENV=development
NGERTIIN_PORT=8000
# Optional absolute or repository-relative path. Omit to use .dev/harness-first.
NGERTIIN_STATE_DIR=
# Composio Platform project key. Loaded only by the backend; never inherited by harnesses.
COMPOSIO_API_KEY=
# installation.json stores the server-owned owner UUID and private local API token.
# Native adapters use connection-owned credential references; see docs/architecture/api-consumer-contract.md.

# PostgreSQL is required. SQLite data is imported only through the offline migration command.
NGERTIIN_DATABASE_URL=postgresql://ngertiin:change-me@127.0.0.1:55472/ngertiin
NGERTIIN_DATABASE_SCHEMA=ngertiin_app
# Optional restricted login; must be a non-owner member of ngertiin_runtime.
# The migration/authority connection above remains separate.
NGERTIIN_APPLICATION_DATABASE_URL=
# Persistent local PostgreSQL through compose.postgres.local.yml (OrbStack).
NGERTIIN_POSTGRES_PASSWORD=change-me
NGERTIIN_POSTGRES_PORT=55472

# Account authentication is always enabled. bun dev starts API, web, Tauri and the local inbox.
# Development defaults to the web origin below and creates a private persistent auth secret.
# Production requires explicit HTTPS, a >=32-character secret and Resend delivery credentials.
NGERTIIN_AUTH_URL=
NGERTIIN_AUTH_SECRET=
NGERTIIN_AUTH_SCHEMA=ngertiin_auth
NGERTIIN_AUTH_NATIVE_REDIRECT_URI=http://127.0.0.1:43119/callback
# Defaults: local in development, resend in production. Local messages stay in private state.
NGERTIIN_AUTH_EMAIL_DELIVERY=
NGERTIIN_AUTH_EMAIL_FROM=
NGERTIIN_AUTH_RESEND_API_KEY=
NGERTIIN_WEB_PORT=3001
NGERTIIN_DEV_INBOX_PORT=8025

# Scoped provider credentials: keep the binary 32-byte master key and latest revocation ledger outside state rollback targets.
NGERTIIN_PROVIDER_MASTER_KEY_FILE=
NGERTIIN_PROVIDER_REVOCATIONS_DIR=
# Set only after verifying native provider storage and backups are encrypted.
NGERTIIN_PROVIDER_NATIVE_STORAGE=

# Optional harness executable overrides. Codex ACP and its native account/runtime CLI are separate.
NGERTIIN_CODEX_ACP_EXECUTABLE=
NGERTIIN_CODEX_EXECUTABLE=
NGERTIIN_CLAUDE_ACP_EXECUTABLE=
NGERTIIN_OPENCODE_EXECUTABLE=
NGERTIIN_PI_ACP_EXECUTABLE=
