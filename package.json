{
  "name": "ngertiin",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/avatar",
    "apps/server",
    "apps/web-client",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "bun run --filter @ngertiin/server dev",
    "dev:web-client": "bun --filter @ngertiin/web-client dev",
    "build:web-client": "bun --filter @ngertiin/web-client build",
    "typecheck:web-client": "bun --filter @ngertiin/web-client typecheck",
    "lint:web-client": "bun --filter @ngertiin/web-client lint",
    "dev:api": "bun run --filter @ngertiin/server dev",
    "setup": "bun apps/server/src/setup.ts",
    "build": "bun run build:web-client",
    "typecheck": "bun run --filter @ngertiin/server typecheck && bun run typecheck:web-client",
    "lint": "bun run --filter @ngertiin/server lint && bun run lint:web-client",
    "format": "bun --filter @ngertiin/web-client format",
    "check": "bun run lint && bun run typecheck && bun run test:server",
    "docs:check": "bun scripts/check-docs.ts",
    "test:server": "bun run --filter @ngertiin/server test",
    "verify:foundation": "bun scripts/verification/nma072/run-tests.ts tests/lifecycle.test.ts tests/persistence/postgres.test.ts tests/bootstrap.test.ts",
    "setup:machine": "bun apps/server/src/machines/setup.ts",
    "import:machine": "bun apps/server/src/machines/import.ts",
    "setup:desktop": "bun apps/desktop/scripts/setup.ts",
    "dev:desktop": "bun apps/desktop/scripts/dev.ts",
    "package:desktop": "bun --filter @ngertiin/desktop package",
    "test:desktop": "bun --filter @ngertiin/desktop test",
    "typecheck:desktop": "bun --filter @ngertiin/desktop typecheck",
    "lint:desktop": "bun --filter @ngertiin/desktop lint",
    "dev:desktop-rs": "bun --cwd apps/desktop-rs dev",
    "gallery:desktop-rs": "bun --cwd apps/desktop-rs gallery",
    "check:desktop-rs": "bun --cwd apps/desktop-rs check",
    "db:sqlite-import": "bun apps/server/src/persistence/cli.ts",
    "test:postgres": "bun run --filter @ngertiin/server test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
