# Local development only. Copy to .env; use separate production credentials.
APP_ENV=development
ENABLE_DEV_DIAGNOSTICS=true
WEB_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:8000
DATABASE_URL=postgresql://ngertiin:ngertiin_local@localhost:5433/ngertiin
POSTGRES_USER=ngertiin
POSTGRES_PASSWORD=ngertiin_local
POSTGRES_DB=ngertiin

# Create a separate Clerk development application, then fill these values.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MinIO development storage. For R2 use a separate .env.r2 (see docs).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ngertiin-development
S3_ACCESS_KEY_ID=ngertiin_local
S3_SECRET_ACCESS_KEY=ngertiin_local_storage
S3_ADDRESSING_STYLE=path
MINIO_ROOT_USER=ngertiin_local
MINIO_ROOT_PASSWORD=ngertiin_local_storage

# Chat agent (server/worker only; never prefix these keys with VITE_).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TASK_BUDGET_UNITS=60000
TASK_ACCOUNT_DAILY_UNITS=240000
TASK_GLOBAL_DAILY_UNITS=2400000
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MAX_OUTPUT_TOKENS=3000
CHAT_MAX_MODEL_CALLS=6
CHAT_RUN_TIMEOUT_SECONDS=180

# Personal memory: Mem0 OSS in the backend, existing PostgreSQL/pgvector.
# No Mem0 Cloud credential. Uses OPENAI_API_KEY/OPENAI_BASE_URL above.
MEMORY_ENABLED=true
MEMORY_EXTRACTION_MODEL=gpt-5-mini
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMS=1536
MEMORY_INPUT_BYTES=6000
MEMORY_CONTEXT_BYTES=4000
# Conservative internal token units, independent of commercial chat allowance.
MEMORY_JOB_UNITS=160000
MEMORY_ACCOUNT_DAILY_UNITS=250000
MEMORY_GLOBAL_DAILY_UNITS=2500000

# NG-019: generation + Jev judgments. Account preview is opt-in; no automatic delivery.
PROACTIVE_ENABLED=true
PROACTIVE_GENERATION_MODEL=gpt-6-luna
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
PROACTIVE_DAILY_EVALUATIONS=12
PROACTIVE_EVALUATION_UNITS=100000
PROACTIVE_ACCOUNT_DAILY_UNITS=300000
PROACTIVE_GLOBAL_DAILY_UNITS=3000000

# NG-034 PDF/image OCR. Reuse Mistral credits; keep model/policy pinned.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-1
# Internal cost estimate, not a customer price or provider invoice.
MISTRAL_OCR_USD_PER_1000_PAGES=4
OCR_ACCOUNT_DAILY_PAGES=100
OCR_GLOBAL_DAILY_PAGES=1000
FILE_MAX_BYTES=10485760
FILE_BATCH_BYTES=26214400
FILE_ACCOUNT_BYTES=262144000

# NG-031 development trial. Server only; resource creation is explicit.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Optional; leaving empty uses the organization's default region.
DAYTONA_TARGET=
SANDBOX_PROVIDER=daytona
SANDBOX_PRICE_VERSION=daytona-linux-2026-10-18
SANDBOX_RESOURCE_MICROUSD_PER_HOUR=166464
# Internal operating caps in micro USD, independent of commercial chat allowance.
SANDBOX_ACCOUNT_DAILY_MICROUSD=1000000
SANDBOX_GLOBAL_DAILY_MICROUSD=5000000

# NG-036 private browser. Compute stops at the deadline; profile has separate retention.
COMPUTER_TASK_SECONDS=1200
COMPUTER_RETENTION_DAYS=7
# Full 8 GiB retained-disk hourly estimate in micro USD; not a customer price.
COMPUTER_STORAGE_MICROUSD_PER_HOUR=864

# Optional tracing. Leave disabled for local acceptance.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ngertiin-development
