# Product API and web. No alternate execution mode exists.
APP_ENV=development
ENABLE_DEV_DIAGNOSTICS=true
WEB_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:8000
DATABASE_URL=postgresql://ngertiin:ngertiin_local@localhost:5433/ngertiin
POSTGRES_USER=ngertiin
POSTGRES_PASSWORD=ngertiin_local
POSTGRES_DB=ngertiin
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional verified user.created delivery; first authenticated access also enqueues setup.
CLERK_WEBHOOK_SIGNING_SECRET=

# Operator-owned usage exemptions: existing internal account UUIDs, not emails or Clerk IDs.
# This preserves accounting, isolation, timeouts and execution safety limits.
UNLIMITED_ACCOUNT_IDS=[]

# Private account-to-engine socket/key registry; required for agent execution.
NMA_PARTITIONS_FILE=.dev/engine/partitions.json
# Accounts are discovered from durable provisioning intents; no owner allowlist.
# Optional short development state root; preserve it across restarts.
NMA_STATE_ROOT=
# Production: trusted JSON argv for an idempotent isolated partition supervisor.
NMA_PARTITION_DRIVER=[]
HERMES_SOURCE=.dev/nma-001/source
NMA_RUNTIME_PYTHON=.dev/nma-040/production/bin/python
# Production requires an isolated partition driver; never use the local launcher there.
# Optional one-time connection bootstrap for this verified internal account UUID only.
# Existing owner catalogs retain their assignment. New accounts connect providers in settings.
NMA_BOOTSTRAP_OWNER_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# Enable only for an eligible local OSS installation, not hosted partner availability.
NMA_CHATGPT_LOCAL_OSS=0
E2B_API_KEY=
E2B_COMPUTER_TEMPLATE=ngertiin-desktop-v2

# Retained historical object storage; never delete its volume during cutover.
MINIO_ROOT_USER=ngertiin_local
MINIO_ROOT_PASSWORD=ngertiin_local_storage

# Subscription billing (server only). Keep providers disabled until configured.
BILLING_MODE=test
# Public HTTPS webhook origin. Leave empty until the billing callback is reachable.
BILLING_PUBLIC_API_URL=
# Paused pending provider activation; Lemon Squeezy is the current checkout gateway.
DUITKU_ENABLED=false
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CARD_METHOD=MG
# Subscription v1 documents MD5; confirm the merchant API contract before changing.
DUITKU_SIGNATURE_ALGORITHM=md5
LEMONSQUEEZY_ENABLED=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_CURRENCY=IDR
# Rp270,750 = USD15 at BI JISDOR 2026-10-19; Lemon Squeezy amounts use cents.
LEMONSQUEEZY_PRICE_MINOR=27075000
LEMONSQUEEZY_WEBHOOK_SECRET=
