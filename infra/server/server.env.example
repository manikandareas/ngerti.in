APP_ENV=production
NGERTIIN_PROJECT_ROOT=/opt/ngertiin/current
NGERTIIN_CONFIG_FILE=/etc/ngertiin/server.env
NGERTIIN_STATE_DIR=/srv/ngertiin/state
NGERTIIN_PORT=8000
NGERTIIN_DATABASE_URL=postgresql://ngertiin:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55482/ngertiin
NGERTIIN_APPLICATION_DATABASE_URL=postgresql://ngertiin_client:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55482/ngertiin
NGERTIIN_DATABASE_SCHEMA=ngertiin_app
NGERTIIN_AUTH_URL=https://REPLACE_WITH_HOSTNAME
NGERTIIN_AUTH_SECRET=REPLACE_WITH_48_RANDOM_BYTES_AS_HEX
NGERTIIN_AUTH_SCHEMA=ngertiin_auth
NGERTIIN_AUTH_NATIVE_REDIRECT_URI=http://127.0.0.1:43119/callback
NGERTIIN_AUTH_EMAIL_DELIVERY=resend
NGERTIIN_AUTH_EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
NGERTIIN_AUTH_RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
NGERTIIN_CODEX_EXECUTABLE=/opt/ngertiin/bin/codex
NGERTIIN_MUSE_EXECUTABLE=/opt/ngertiin/bin/muse
NGERTIIN_MACHINE_ASSETS_DIR=/opt/ngertiin/machine-assets
NGERTIIN_PROVIDER_MASTER_KEY_FILE=/srv/ngertiin/trust/provider.key
NGERTIIN_PROVIDER_REVOCATIONS_DIR=/srv/ngertiin/trust/revocations
# Set to encrypted-volume only after verifying encryption of native state and backups.
NGERTIIN_PROVIDER_NATIVE_STORAGE=
