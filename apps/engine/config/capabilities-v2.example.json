{
  "version": 2,
  "new_agent_template": {
    "version": 1,
    "tool_grants": ["tasks", "files"],
    "mcp_grants": [],
    "skill_refs": []
  },
  "execution_surfaces": {
    "native_linux": {
      "kind": "scoped_linux",
      "ready": false,
      "image": "sha256:REPLACE_WITH_VERIFIED_IMAGE_ID"
    }
  },
  "tool_grants": {
    "tasks": {"enabled": true, "label": "Tasks", "toolset": "todo"},
    "files": {"enabled": true, "label": "Files", "toolset": "nma_workspace"},
    "native_terminal": {
      "enabled": false,
      "label": "Native terminal",
      "toolset": "terminal",
      "execution_surface": "native_linux"
    },
    "native_browser": {
      "enabled": false,
      "label": "Native browser",
      "toolset": "browser",
      "execution_surface": "native_linux",
      "requires": ["native_terminal"]
    },
    "native_files": {
      "enabled": false,
      "label": "Native filesystem and document extraction",
      "toolset": "file",
      "execution_surface": "native_linux",
      "requires": ["native_terminal"]
    },
    "native_code": {
      "enabled": false,
      "label": "Native code kernel and tool RPC",
      "toolset": "code_execution",
      "execution_surface": "native_linux",
      "requires": ["native_terminal", "native_files"]
    },
    "native_coding": {
      "enabled": false,
      "label": "Projects, diagnostics, checkpoints and worktrees",
      "toolset": "nma_coding",
      "execution_surface": "native_linux",
      "requires": ["native_terminal", "native_files"]
    }
  },
  "mcp_grants": {},
  "skill_refs": {}
}
