              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "uXbmA",
                  "name": "Rule heading",
                  "fill": "$gumloop/brand-ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keyboard and focus",
                  "lineHeight": 1.4,
                  "fontFamily": "$gumloop/font-ui",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "r9rvb",
                  "name": "Rule description",
                  "fill": "$gumloop/brand-body-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Visible 3 px focus ring. Focus follows the visual order. Dialogs trap focus and return it when closed. Escape closes transient overlays.",
                  "lineHeight": 1.4,
                  "fontFamily": "$gumloop/font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wXZeZ",
              "name": "Touch and feedback",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "QzcIy",
                  "name": "Rule heading",
                  "fill": "$gumloop/brand-ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Touch and feedback",
                  "lineHeight": 1.4,
                  "fontFamily": "$gumloop/font-ui",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "kJUen",
                  "name": "Rule description",
                  "fill": "$gumloop/brand-body-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Use a 44 px effective target even when the visible control is 32–36 px. Every loading state has a text label. Avoid relying on color alone.",
                  "lineHeight": 1.4,
                  "fontFamily": "$gumloop/font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "IHjbE",
              "name": "Forms and semantics",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "p1ssq",
                  "name": "Rule heading",
                  "fill": "$gumloop/brand-ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Forms and semantics",
                  "lineHeight": 1.4,
                  "fontFamily": "$gumloop/font-ui",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "q4oAVJ",
                  "name": "Rule description",
                  "fill": "$gumloop/brand-body-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Always pair inputs with labels. Keep error messages specific and adjacent. Use aria-expanded for disclosures and clear names for icon-only actions.",
                  "lineHeight": 1.4,
                  "fontFamily": "$gumloop/font-ui",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "vsd87",
          "name": "Specification",
          "fill": "$gumloop/brand-body-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Source semantic foregrounds can miss 4.5:1 on their tinted backgrounds. The a11y-* text tokens are deliberate extensions for normal-sized text; original source tokens remain unchanged. Gellix fallback availability and authenticated product behavior remain unverified.",
          "lineHeight": 1.4,
          "fontFamily": "$gumloop/font-mono",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
