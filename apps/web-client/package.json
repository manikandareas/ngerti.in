{
  "name": "@ngertiin/web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "preview": "vite preview",
    "test:e2e": "bun run build && playwright test",
    "test:avatar": "bun test verification/avatar-engine.test.ts && bun run build && playwright test --config playwright.avatar.config.ts",
    "test:conversation": "bun run build && playwright test --config playwright.conversation.config.ts",
    "test:work": "bun run build && playwright test --config playwright.work.config.ts"
  },
  "dependencies": {
    "@ngertiin/avatar": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@lexical/react": "0.53.0",
    "@novnc/novnc": "1.7.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lexical": "0.53.0",
    "lucide-react": "0.539.0",
    "next-themes": "^0.4.6",
    "papaparse": "5.7.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.16.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/novnc__novnc": "1.6.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
