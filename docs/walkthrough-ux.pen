                  "fill": "$foreground",
                  "content": "Satu instruksi, dua jalur protein",
                  "fontFamily": "Nunito Sans",
                  "fontSize": 20,
                  "fontWeight": "800"
                },
                {
                  "type": "frame",
                  "id": "pEdIG",
                  "name": "Alur produksi dan sekresi protein",
                  "clip": true,
                  "width": "fill_container",
