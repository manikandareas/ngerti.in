{
  "name": "ngertiin",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "bun run --filter @ngertiin/server dev",
    "dev:web": "bun --env-file=.env --filter @ngertiin/web dev",
    "dev:api": "bun run --filter @ngertiin/server dev",
    "setup": "bun apps/server/src/setup.ts",
    "build": "bun --filter @ngertiin/web build",
    "typecheck": "bun run --filter @ngertiin/server typecheck && bun --filter @ngertiin/web typecheck",
    "lint": "biome check apps/web && bun run --filter @ngertiin/server lint",
    "format": "biome check --write apps/web",
    "check": "bun run lint && bun run typecheck && bun run test:server",
    "test:server": "bun run --filter @ngertiin/server test",
    "verify:foundation": "bun scripts/verification/nma047/foundation.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
