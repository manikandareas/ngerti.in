{
  "name": "github-dark-default",
  "appearance": "dark",
  "style": {
    "editor.background": "#0d1117",
    "editor.foreground": "#e6edf3",
    "editor.line_number": "#6e7681",
    "editor.active_line_number": "#e6edf3",
    "syntax": {
      "attribute": {
        "color": "#79c0ff"
      },
      "boolean": {
        "color": "#79c0ff"
      },
      "comment": {
        "color": "#8b949e"
      },
      "comment_doc": {
        "color": "#8b949e"
      },
      "constant": {
        "color": "#79c0ff"
      },
      "constructor": {
        "color": "#d2a8ff"
      },
      "function": {
        "color": "#d2a8ff"
      },
      "keyword": {
        "color": "#ff7b72"
      },
      "number": {
        "color": "#79c0ff"
      },
      "operator": {
        "color": "#ff7b72"
      },
      "property": {
        "color": "#79c0ff"
      },
      "punctuation": {
        "color": "#e6edf3"
      },
      "punctuation.bracket": {
        "color": "#e6edf3"
      },
      "punctuation.delimiter": {
        "color": "#e6edf3"
      },
      "string": {
        "color": "#a5d6ff"
      },
      "string.escape": {
        "color": "#ff7b72"
      },
      "string.regex": {
        "color": "#a5d6ff"
      },
      "tag": {
        "color": "#7ee787"
      },
      "type": {
        "color": "#ffa657"
      },
      "variable": {
        "color": "#e6edf3"
      },
      "preproc": {
        "color": "#ff7b72"
      },
      "label": {
        "color": "#ffa657"
      },
      "embedded": {
        "color": "#e6edf3"
      }
    }
  }
}
